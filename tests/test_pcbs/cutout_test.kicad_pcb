(kicad_pcb
	(version 20260206)
	(generator "gridghost_cutout_test")
	(general (thickness 1.6))
	(layers
		(0 "F.Cu" signal)
		(31 "B.Cu" signal)
		(25 "Edge.Cuts" user)
	)
	(setup (pad_to_mask_clearance 0))

	# Cutout test board — IMPROVEMENTS §2.1.
	# 80x60mm outline with a 10x10mm internal milled slot (keepout) dead
	# centre. U1 starts ON the slot so the macro-v2 legalizer's
	# _keepout_clamp must evict it. R1/R2 sit clear and give the board a
	# second/third macro so push-apart has something to reason about.

	(footprint "Test:SOIC-8"
		(layer "F.Cu")
		(at 40 30)
		(property "Reference" "U1" (at 0 -5 0) (layer "F.SilkS"))
		(property "Value" "MCU" (at 0 5 0) (layer "F.Fab"))
		(pad "1" smd rect (at -2 -2) (size 1 0.5) (layers "F.Cu" "F.Mask" "F.Paste"))
		(pad "2" smd rect (at -2 0) (size 1 0.5) (layers "F.Cu" "F.Mask" "F.Paste"))
		(pad "3" smd rect (at -2 2) (size 1 0.5) (layers "F.Cu" "F.Mask" "F.Paste"))
		(pad "4" smd rect (at 2 -2) (size 1 0.5) (layers "F.Cu" "F.Mask" "F.Paste"))
		(pad "5" smd rect (at 2 2) (size 1 0.5) (layers "F.Cu" "F.Mask" "F.Paste"))
	)

	(footprint "Test:R0603"
		(layer "F.Cu")
		(at 10 10)
		(property "Reference" "R1" (at 0 -2 0) (layer "F.SilkS"))
		(property "Value" "10k" (at 0 2 0) (layer "F.Fab"))
		(pad "1" smd rect (at -0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Mask" "F.Paste"))
		(pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Mask" "F.Paste"))
	)

	(footprint "Test:R0603"
		(layer "F.Cu")
		(at 70 50)
		(property "Reference" "R2" (at 0 -2 0) (layer "F.SilkS"))
		(property "Value" "10k" (at 0 2 0) (layer "F.Fab"))
		(pad "1" smd rect (at -0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Mask" "F.Paste"))
		(pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu" "F.Mask" "F.Paste"))
	)

	(gr_rect (start 0 0) (end 80 60)
		(stroke (width 0.1) (type solid)) (fill none) (layer "Edge.Cuts")
		(tstamp "00000000-0000-0000-0000-000000000001"))
	(gr_rect (start 35 25) (end 45 35)
		(stroke (width 0.1) (type solid)) (fill none) (layer "Edge.Cuts")
		(tstamp "00000000-0000-0000-0000-000000000002"))
)
